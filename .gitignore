# 依赖与构建产物
node_modules/
dist/
coverage/

# Wrangler 本地状态与本地秘密（秘密一律经 Wrangler secret 注入，不入仓库）
.wrangler/
.dev.vars
.dev.vars.*

# 环境变量文件
.env
.env.*

# 系统杂项
.DS_Store
Thumbs.db

# 日志
*.log

# Playwright 产物（截图证据单独复制到 docs/evidence/ 提交）
test-results/
playwright-report/

# Astro 生成的本地类型与缓存（build/dev 时重建）
apps/web/.astro/

# 本地 git worktree（放在仓库内会让 Biome 报 "nested root configuration"，
# 且容易被 git add -A 误收为 gitlink；建议把 worktree 建在仓库外）
.worktrees/
