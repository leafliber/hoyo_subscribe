// P3-11 获准跨卡接线：WATCHDOG_INTERVAL 派生的 Cron，scheduled 测试校验一致性。
// P1-01 占位部署配置（任务卡 P1-01）。
// 所有绑定均为占位值，不指向任何生产资源；真实资源名与 ID 由所有者在部署时创建并替换。
// 开发/预览环境不连接生产用户发送链（主方案 §10.5）。
// 注意：修改绑定后运行 pnpm --filter @hoyo/worker run types 重新生成 worker-configuration.d.ts。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "triggers": { "crons": ["*/10 * * * *"] },
  "name": "hoyo-subscribe-worker",
  "main": "src/index.ts",
  // compatibility_date 与 Wrangler 版本一起固定，不随手升级（ENGINEERING.md §2）。
  // 上限受 @cloudflare/vitest-pool-workers 内置 workerd（1.20260815，支持至 2026-08-22）约束，
  // 升级测试运行时时一并评估此日期。
  "compatibility_date": "2026-08-01",

  // 2026-10-06 所有者在面板开启 Workers Logs（含调用日志），这里同步，保持本地开发与线上一致（ADR-0024）。
  // 源码外的正式部署配置要写同样的块。调用日志会记下完整请求 URL 与请求元数据，
  // 个人 Feed 与退订路径里的 token 因此进入 Workers Logs（保留 7 天）。
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // P5-05：网页与 Worker 同项目；动态能力路径始终先进 Worker。
  // 不加 ASSETS 绑定：静态命中由平台直达，未知路径交给现有 Worker 返回 404。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/feeds/*", "/unsubscribe/*", "/email/one-click/*"]
  },

  // D1：正式状态源（主方案 §2.1）。database_id 为占位 UUID，非真实资源。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoyo-subscribe-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],

  // 两个固定 SQLite-backed DO：PipelineDO/main 与 DeliveryDO/main（主方案 §2.1）。
  // 不按账号或文章创建 DO；类实现见 src/executors/。
  "durable_objects": {
    "bindings": [
      { "name": "PIPELINE_DO", "class_name": "PipelineDO" },
      { "name": "DELIVERY_DO", "class_name": "DeliveryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PipelineDO", "DeliveryDO"] }],

  // P3-17（ADR-0009）：Workers AI 绑定 AI 只写进源码外的正式部署配置："ai": { "binding": "AI" }。
  // 本文件同时是 vitest 的绑定来源；声明 AI 会让测试启动远程代理会话、要求平台登录，
  // 违反"测试不连远端、不烧额度"（ENGINEERING.md §4.1 规则 3）。缺绑定时草稿任务明确停在未配置。

  // Queue：仅承接邮件反馈，不保存数月后的提醒（主方案 §2.1）。这里只声明配置，不操作远端资源。
  "queues": {
    // P4-07：FEEDBACK_BATCH / FEEDBACK_MAX_RETRIES 的声明式投影，feedback 配置测试防漂移。
    // 仅本地声明；所有者上线前替换 HTTP pull 消费者并准备 DLQ，本卡不操作资源。
    "consumers": [
      {
        "queue": "hoyo-mail-events",
        "max_batch_size": 10,
        "max_retries": 8,
        "dead_letter_queue": "hoyo-mail-events-dlq"
      }
    ]
  },

  // 原生 send_email 是唯一首版发送路径；认证与业务使用不同发件子域（主方案 §2.2）。
  // 绑定为占位，不指向生产发送链。
  // P4-03 获准配置：平台按用途锁定所有者指定的发件地址。
  "send_email": [
    { "name": "AUTH_MAILER", "allowed_sender_addresses": ["hoyo-sub@auth.hoyo.airo.cc"] },
    { "name": "BIZ_MAILER", "allowed_sender_addresses": ["hoyo-sub@hoyo.airo.cc"] }
  ]
}
