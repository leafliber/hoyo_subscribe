---
import type { GameId } from "@hoyo/contracts";
import { GAME_ICON_SIZE, GAME_ICON_SRC } from "../lib/game-icons";

interface Props {
  game: GameId;
  class?: string;
}

const { game, class: className = "game-icon" } = Astro.props;
---
<span class={className} data-game={game} aria-hidden="true"><img src={GAME_ICON_SRC[game]} alt="" width={GAME_ICON_SIZE} height={GAME_ICON_SIZE} decoding="async" /></span>
