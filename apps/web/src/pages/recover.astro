---
import "../styles/base.css";
import { OTP_DIGITS, OTP_TTL } from "@hoyo/contracts";
import Icon from "../components/Icon.astro";
import Layout from "./_Layout.astro";
import "../features/auth/auth.css";

const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<Layout title="恢复码与账号恢复" noindex>
  <div id="recovery" class="recovery-page" data-sitekey={sitekey}>
    <header class="page-header">
      <div>
        <p class="eyebrow"><Icon name="shield" />账号安全</p>
        <h1>恢复码与账号恢复</h1>
        <p class="lead">邮箱无法使用时，可以用恢复码重新登录，或者紧急停用所有服务。</p>
      </div>
    </header>

    <section id="purpose-section" aria-labelledby="purpose-title">
      <h2 id="purpose-title" class="visually-hidden">先选择你要做什么</h2>
      <div class="recovery-options">
        <div class="card recovery-option">
          <h3><Icon name="key" />恢复登录</h3>
          <p class="text-secondary">邮箱用不了时，用恢复码重新登录。会先做一次安全暂停（撤销所有登录和日历链接、关闭业务邮件、暂停 Push），然后让你保存新的恢复码。</p>
          <p class="callout callout--info">本次会消耗当前恢复码；激活后必须保存并确认新码，才能重新开启通知或更换邮箱。</p>
          <button class="button" id="choose-login" type="button">选择恢复登录</button>
        </div>
        <div class="card recovery-option recovery-option--danger">
          <h3><Icon name="shield" />紧急停用</h3>
          <p class="text-secondary">怀疑账号被别人使用时：撤销所有登录会话和日历地址，关闭业务邮件、暂停 Push。订阅设置会保留。</p>
          <p class="callout callout--success">本次不会消耗恢复码，之后仍可用它恢复登录。</p>
          <button class="button button--danger" id="choose-stop" type="button">选择紧急停用</button>
        </div>
      </div>
      <p class="text-aux">已经登录了？<a href="/recover#save" id="open-save">查看或保存恢复码</a></p>
    </section>

    <section id="credential-section" class="card recovery-panel-card" hidden aria-labelledby="credential-title">
      <h2 id="credential-title" tabindex="-1">输入恢复码</h2>
      <form id="recovery-form" autocomplete="off">
        <div class="field"><label for="recovery-id">恢复码 ID</label><input id="recovery-id" class="mono" autocomplete="off" spellcheck="false" required /></div>
        <div class="field"><label for="recovery-secret">恢复码秘密</label><input id="recovery-secret" type="password" autocomplete="off" required /></div>
        <p id="purpose-consequence" class="callout callout--info"></p>
        <div class="recovery-actions">
          <button class="button" id="submit-recovery" type="submit">确认操作</button>
          <button class="button button--ghost" id="change-purpose" type="button">重新选择</button>
        </div>
      </form>
    </section>

    <section id="pending-section" class="card recovery-panel-card" hidden aria-labelledby="pending-title">
      <h2 id="pending-title">确认在这台设备登录</h2>
      <p class="text-secondary">确认后会立即为你生成新的恢复码。</p>
      <fieldset id="device-selection" class="device-selection" hidden>
        <legend>登录设备已满，请选择要退出的旧设备</legend>
        <p class="field-hint">不会自动退出其他设备。退出登录不等于暂停那台设备的浏览器通知。</p>
        <p id="session-lag" class="field-hint"></p>
        <div id="session-list" class="device-list"></div>
      </fieldset>
      <button class="button" id="activate-recovery" type="button">激活并保存新恢复码</button>
    </section>

    <section id="save-section" class="card recovery-panel-card" hidden aria-labelledby="save-title">
      <h2 id="save-title" tabindex="-1">保存恢复码</h2>
      <p class="text-secondary">邮箱无法使用时，恢复码是找回账号的唯一凭证。它只会显示这一次，请保存在安全的地方（例如密码管理器），并且和邮箱分开保管。首次启用日历订阅或邮件通知前需要先保存。</p>
      <p id="recovery-pause" class="callout callout--warning" hidden>原来的日历地址已失效，邮件与 Push 已暂停；订阅设置仍然保留。保存新码后，请逐项重新开启需要的通知，并在日历应用里换成新地址。</p>
      <div class="recovery-actions"><button class="button button--secondary" id="use-recovery" type="button" hidden>使用恢复码恢复登录或紧急停用</button></div>
      <p id="code-state" class="code-state">正在读取恢复码状态…</p>
      <div class="recovery-actions"><button class="button" id="generate-code" type="button"><Icon name="key" />生成新恢复码</button></div>
      <div id="delivered-code" class="code-box" hidden>
        <label for="code-output" class="field-label">本次交付的恢复码（ID 与秘密，请一起保存）</label>
        <textarea id="code-output" class="input" readonly autocomplete="off" spellcheck="false" rows="3"></textarea>
        <div class="recovery-actions">
          <button class="button button--secondary" id="copy-code" type="button"><Icon name="copy" />复制恢复码</button>
          <button class="button button--secondary" id="download-code" type="button"><Icon name="download" />下载恢复码</button>
        </div>
        <p class="field-hint">下载的文件只包含恢复码，和普通的设置导出分开。请不要发给任何人。</p>
        <label class="check-label"><input id="saved-check" type="checkbox" />我已单独保存这份恢复码</label>
        <div class="recovery-actions"><button class="button" id="confirm-code" type="button" disabled>确认已保存</button></div>
        <p class="field-hint">你的确认不代表网站已经验证外部备份可靠。</p>
      </div>
      <section id="rotation-section" hidden aria-labelledby="rotation-title">
        <h3 id="rotation-title">找不到以前保存的恢复码？</h3>
        <p class="text-secondary">旧码无法重新显示，但可以换一个新码：先验证当前邮箱，再生成新码。新码确认保存前，旧码仍然有效。</p>
        <div id="rotation-captcha"></div><p id="captcha-status" class="field-hint"></p>
        <div class="recovery-actions"><button class="button button--secondary" id="request-rotation" type="button">验证邮箱以轮换恢复码</button></div>
        <form id="rotation-form" hidden>
          <div class="field">
            <label for="rotation-otp">当前邮箱验证码</label>
            <input id="rotation-otp" class="otp-input" inputmode="numeric" autocomplete="one-time-code" maxlength={OTP_DIGITS} required />
            <p class="field-hint">可整段粘贴 {OTP_DIGITS} 位验证码，{OTP_TTL / 60} 分钟内有效。邮件可能稍晚到达。</p>
          </div>
          <div class="recovery-actions"><button class="button" id="verify-rotation" type="submit">验证本次轮换</button></div>
        </form>
        <div class="recovery-actions"><button class="button" id="rotate-code" type="button" disabled>交付轮换新码</button></div>
        <p id="rotation-reason" class="field-hint"></p>
      </section>
      <section aria-labelledby="capability-title" class="capability-list">
        <h3 id="capability-title">当前可用操作</h3>
        <div class="recovery-actions">
          <a class="button button--secondary" href="/subscription">查看订阅内容</a>
          <button class="button button--secondary" id="export-preferences" type="button"><Icon name="download" />导出偏好</button>
          <a class="button button--ghost" href="/account">账号与设备</a>
        </div>
        <div id="restricted-actions" class="callout callout--warning" hidden>
          <div class="callout-body">
            <p>请先保存并确认新恢复码。在此之前不能启用通知或更换邮箱。</p>
            <div class="recovery-actions"><button class="button button--sm" type="button" disabled>启用日历 / 邮件 / Push</button><button class="button button--sm" type="button" disabled>更换邮箱</button></div>
          </div>
        </div>
        <p id="confirmed-next" hidden><a href="/subscription">继续处理订阅与通道</a> · <a href="/account">管理邮箱</a>。各项通知不会自动重新开启。</p>
        <details class="disclosure">
          <summary>删除账号</summary>
          <p class="text-secondary">删除会停用本站权限与通道，不能即时擦除已送达的邮件、外部日历副本或尚未到期的备份。</p>
          <label class="check-label"><input id="delete-check" type="checkbox" />我确认删除账号</label>
          <div class="recovery-actions"><button class="button button--danger" id="delete-account" type="button" disabled>删除账号并停用服务</button></div>
          <p id="delete-reason" class="field-hint"></p>
        </details>
      </section>
    </section>

    <p id="recovery-result" class="callout callout--info result-message" role="status" tabindex="-1"></p>
    <div class="recovery-actions">
      <button class="button button--secondary" id="retry-recovery" type="button" hidden>核对结果</button>
      <button class="button button--ghost" id="cancel-recovery" type="button" hidden>停止等待</button>
      <button class="button button--ghost" id="refresh-recovery" type="button"><Icon name="refresh" />重新读取当前状态</button>
    </div>
    <p id="reauth-link" class="callout callout--info" hidden><a href="/login?returnTo=%2Frecover%23save">重新验证邮箱并登录</a>，完成后回到本页保存恢复码。</p>
    <p class="recovery-foot">新邮箱仍须验证。如果邮箱、登录设备和恢复码全部丢失，无法仅凭一封说明邮件接管账号。<a href="/status">查看服务状态</a> · <a href="/">返回公开日程</a></p>
    <noscript><p class="callout callout--warning">恢复操作需要 JavaScript；公开日程仍可浏览。</p></noscript>
  </div>
  <script>import "../features/auth/recovery/recovery";</script>
</Layout>
