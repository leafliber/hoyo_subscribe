---
import "../styles/base.css";
import { OTP_ATTEMPTS, OTP_COOLDOWN, OTP_DIGITS, OTP_TTL } from "@hoyo/contracts";
import Icon from "../components/Icon.astro";
import Layout from "./_Layout.astro";
import "../features/auth/sessions/account.css";

const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const otpNote = `验证码 ${OTP_DIGITS} 位，${OTP_TTL / 60} 分钟内有效；重新发送至少间隔 ${OTP_COOLDOWN} 秒，最多可输错 ${OTP_ATTEMPTS} 次。`;
---
<Layout title="账号设置" noindex>
  <div class="account-page" id="account-page" data-sitekey={sitekey}>
    <header class="page-header">
      <div>
        <h1>账号设置</h1>
        <p class="lead">管理登录邮箱、登录设备、浏览器通知和恢复码。时间均为北京时间。</p>
      </div>
      <div class="page-header-actions">
        <button class="button button--secondary" id="account-refresh" type="button"><Icon name="refresh" />刷新</button>
        <button class="button button--secondary" id="account-logout" type="button" data-dialog-open="logout-dialog" disabled><Icon name="log-out" />退出登录</button>
      </div>
    </header>
    <p id="account-result" class="callout callout--info result-message" role="status" tabindex="-1">正在读取账号状态…</p>
    <p class="account-login-row"><a href="/login?returnTo=%2Faccount" id="account-login" class="button">登录或完成激活</a></p>

    <div class="account-layout">
      <nav class="account-nav" aria-label="账号设置目录">
        <a href="#account-info"><Icon name="user" />账号信息</a>
        <a href="#account-devices"><Icon name="monitor" />登录设备</a>
        <a href="#account-push"><Icon name="bell" />浏览器通知</a>
        <a href="#account-security"><Icon name="key" />恢复码<span class="account-nav-note">可选</span></a>
        <a href="#account-data"><Icon name="download" />数据导出</a>
        <a href="#account-danger"><Icon name="trash" />删除账号</a>
      </nav>

      <div class="account-sections">
        <section id="account-info" class="card account-section" aria-labelledby="account-info-title">
          <div class="card-header"><h2 id="account-info-title">账号信息</h2></div>
          <div class="card-body">
            <!-- 只列账号本身的事实；订阅与各接收方式的状态在「我的订阅」查看。不适用的行隐藏。 -->
            <dl class="kv">
              <dt>邮箱</dt><dd id="account-email">未知</dd>
              <dt>登录有效期</dt><dd id="account-expiry">未知</dd>
              <dt data-account-row="lease" hidden>邮件通知名额</dt><dd id="account-lease" data-account-row="lease" hidden>未知</dd>
              <dt data-account-row="reclaim" hidden>账号回收</dt><dd id="account-reclaim" data-account-row="reclaim" hidden>未知</dd>
            </dl>
            <p class="field-hint">长时间不打开网页可能需要重新登录，但这不代表账号不活跃：日历应用在拉取订阅也算在使用。</p>
            <p class="account-links"><a href="/subscription#channels"><Icon name="arrow-right" />查看订阅内容、日历订阅和邮件通知</a></p>
            <details id="email-maintenance" class="disclosure email-change">
              <summary><Icon name="mail" />更换登录邮箱</summary>
              <div class="email-change-body">
                <p class="text-secondary">订阅设置会保留在当前账号。更换后其他设备和旧会话都会退出；这个浏览器会得到一个待确认的新会话，到登录页确认即可，不需要再收验证码。新邮箱的邮件通知需要重新开启。</p>
                <form id="email-target-form" autocomplete="off" class="inline-form">
                  <div class="field"><label for="email-target">新邮箱地址</label><input id="email-target" type="email" autocomplete="off" required /></div>
                  <button id="email-start" class="button" type="submit" disabled>开始验证</button>
                </form>
                <div id="email-proofs" class="proof-steps" hidden>
                  <p class="text-secondary">需要完成两项验证：证明你是账号本人（当前邮箱验证码或恢复码二选一），以及验证新邮箱。</p>
                  {[{ id: "email-current", label: "当前邮箱", step: "1" }, { id: "email-new", label: "新邮箱", step: "2" }].map(({ id, label, step }) => (
                    <div class="proof-card">
                      <h3><span class="proof-step">{step}</span>验证{label}</h3>
                      <div id={`${id}-turnstile`}></div><p id={`${id}-turnstile-status`} class="field-hint" role="status"></p>
                      <button id={`${id}-send`} class="button button--secondary" type="button">向{label}发送验证码</button>
                      <form id={`${id}-form`} autocomplete="off" class="inline-form">
                        <div class="field"><label for={`${id}-code`}>{label}验证码</label><input id={`${id}-code`} class="otp-input" type="password" inputmode="numeric" maxlength={OTP_DIGITS} autocomplete="off" required /></div>
                        <button id={`${id}-verify`} class="button" type="submit" disabled>验证</button>
                      </form>
                      <p id={`${id}-status`} class="proof-status" role="status">尚未验证。</p>
                      {id === "email-current" && (
                        <details class="disclosure disclosure--inline">
                          <summary>当前邮箱收不到？改用恢复码证明</summary>
                          <form id="email-recovery-form" autocomplete="off" class="recovery-proof">
                            <p class="field-hint">用恢复码证明身份不会消耗恢复码。</p>
                            <div class="field"><label for="email-recovery-id">恢复码 ID</label><input id="email-recovery-id" type="password" autocomplete="off" required /></div>
                            <div class="field"><label for="email-recovery-secret">恢复码秘密</label><input id="email-recovery-secret" type="password" autocomplete="off" required /></div>
                            <button id="email-recovery-prove" class="button button--secondary" type="submit">用恢复码证明</button>
                          </form>
                        </details>
                      )}
                    </div>
                  ))}
                  <p class="field-hint">{otpNote}发送成功不代表一定送达。</p>
                  <div class="button-row">
                    <button id="email-confirm" class="button" type="button" disabled>确认更换邮箱</button>
                    <button id="email-cancel" class="button button--ghost" type="button">取消</button>
                  </div>
                </div>
                <p id="email-change-result" class="result-message callout callout--info" role="status"></p>
                <a id="email-activate" class="button" href="/login?returnTo=%2Faccount" hidden>继续激活新会话</a>
              </div>
            </details>
          </div>
        </section>

        <section id="account-devices" class="card account-section" aria-labelledby="account-sessions-title">
          <div class="card-header"><h2 id="account-sessions-title">登录设备</h2></div>
          <div class="card-body">
            <ul id="account-sessions" class="account-sessions"></ul>
            <p id="account-lag" class="field-hint">正在读取设备列表…</p>
            <p class="field-hint">设备名称只用于辨认。退出某台设备的登录，不会关闭那台设备的浏览器通知。</p>
          </div>
        </section>

        <section id="account-push" class="card account-section" aria-labelledby="account-push-title">
          <div class="card-header"><h2 id="account-push-title">浏览器通知</h2></div>
          <div class="card-body">
            <dl class="kv"><dt>本浏览器权限</dt><dd id="account-push-permission">未知</dd></dl>
            <ul id="account-push-list" class="account-sessions"></ul>
            <p id="account-push-status" class="field-hint" role="status">正在读取浏览器通知…</p>
            <p class="field-hint">浏览器通知和登录设备分开管理：退出某台设备的登录不会关闭它的浏览器通知；要停止某个浏览器的通知，请在这里暂停或删除。验证通过也不承诺以后每条都送达。</p>
            <div class="button-row"><a id="account-push-enable" class="button button--secondary" href="/subscription#push-channel" hidden><Icon name="bell" />在当前浏览器开启通知</a></div>
          </div>
        </section>

        <section id="account-security" class="card account-section" aria-labelledby="account-recovery-title">
          <div class="card-header"><h2 id="account-recovery-title">恢复码</h2><span class="badge">可选</span></div>
          <div class="card-body">
            <p class="text-secondary">邮箱无法使用时，可以用恢复码找回账号，或紧急停用所有服务。不创建也能正常使用全部功能。</p>
            <p id="account-recovery" class="recovery-state">恢复码状态未知。</p>
            <div class="button-row">
              <button id="recovery-create" class="button button--secondary" type="button" hidden><Icon name="key" />创建恢复码</button>
              <button id="recovery-rotate" class="button button--secondary" type="button" hidden><Icon name="refresh" />更换恢复码</button>
              <a id="recovery-restricted-link" class="button" href="/recover#save" hidden><Icon name="key" />保存新恢复码</a>
            </div>
            <div id="recovery-verify" class="proof-card" hidden>
              <h3>先验证当前邮箱</h3>
              <p id="recovery-verify-hint" class="field-hint">为了安全，需要先验证当前邮箱。</p>
              <div id="recovery-current-turnstile"></div><p id="recovery-current-turnstile-status" class="field-hint" role="status"></p>
              <button id="recovery-current-send" class="button button--secondary" type="button">向当前邮箱发送验证码</button>
              <form id="recovery-current-form" autocomplete="off" class="inline-form">
                <div class="field"><label for="recovery-current-code">当前邮箱验证码</label><input id="recovery-current-code" class="otp-input" type="password" inputmode="numeric" maxlength={OTP_DIGITS} autocomplete="off" required /></div>
                <button id="recovery-current-verify" class="button" type="submit" disabled>验证</button>
              </form>
              <p id="recovery-current-status" class="proof-status" role="status">尚未验证。</p>
              <p class="field-hint">{otpNote}发送成功不代表一定送达。</p>
              <button id="recovery-verify-cancel" class="button button--ghost" type="button">取消</button>
            </div>
            <div id="recovery-delivered" class="code-box" hidden>
              <label for="recovery-output" class="field-label">你的恢复码（ID 与秘密，请一起保存）</label>
              <textarea id="recovery-output" class="input mono" readonly autocomplete="off" spellcheck="false" rows="3"></textarea>
              <div class="button-row">
                <button class="button button--secondary" id="recovery-copy" type="button"><Icon name="copy" />复制恢复码</button>
                <button class="button button--secondary" id="recovery-download" type="button"><Icon name="download" />下载恢复码</button>
              </div>
              <p class="field-hint">只显示这一次。请保存在密码管理器等安全的地方，和邮箱分开保管，不要发给任何人。下载的文件只包含恢复码。</p>
              <label class="check-label"><input id="recovery-saved-check" type="checkbox" />我已单独保存这份恢复码</label>
              <div class="button-row"><button class="button" id="recovery-confirm" type="button" disabled>确认已保存</button></div>
              <p class="field-hint">没有确认就离开页面的话，这份码会在重新创建时作废。你的确认不代表网站验证过外部备份。</p>
            </div>
            <p id="recovery-result" class="result-message callout callout--info" role="status"></p>
            <p class="field-hint">需要用恢复码时（例如邮箱收不到验证码），在登录页选择「用恢复码找回账号」。</p>
          </div>
        </section>

        <section id="account-data" class="card account-section" aria-labelledby="account-export-title">
          <div class="card-header"><h2 id="account-export-title">数据导出</h2></div>
          <div class="card-body">
            <p class="text-secondary">导出订阅设置（JSON）。不包含邮箱、恢复码、日历链接或通知授权，可在「我的订阅」中导入。</p>
            <div class="button-row"><button class="button button--secondary" id="account-export" type="button" disabled><Icon name="download" />导出订阅偏好</button></div>
          </div>
        </section>

        <section id="account-danger" class="card card--danger account-section" aria-labelledby="account-danger-title">
          <div class="card-header"><h2 id="account-danger-title">删除账号</h2></div>
          <div class="card-body">
            <p class="text-secondary">删除会立即停用账号权限和所有通知，随后清理数据。已经发出的邮件、日历应用里已同步的内容和尚未到期的备份无法立即删除。</p>
            <p id="account-delete-reason" class="field-hint">读取账号后才能确认删除条件。</p>
            <div class="button-row"><button class="button button--danger-outline" id="account-delete-open" type="button" data-dialog-open="delete-dialog" disabled><Icon name="trash" />删除账号…</button></div>
            <p id="account-deletion" class="result-message callout callout--warning" role="status"></p>
          </div>
        </section>
      </div>
    </div>
  </div>

  <div id="logout-dialog" class="dialog" role="dialog" aria-modal="true" aria-labelledby="logout-title" hidden>
    <div class="dialog-backdrop" data-dialog-close></div>
    <div class="dialog-panel" data-dialog-panel tabindex="-1">
      <h2 id="logout-title">选择退出方式</h2>
      <p class="text-secondary">只会退出这台设备的登录，日历订阅和邮件通知不受影响。</p>
      <div class="dialog-actions">
        <button class="button button--secondary" type="button" data-dialog-close>取消</button>
        <button class="button button--secondary" id="logout-pause" type="button" hidden>退出并暂停本浏览器通知</button>
        <button class="button" id="logout-only" type="button">仅退出账号</button>
      </div>
    </div>
  </div>

  <div id="delete-dialog" class="dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title" hidden>
    <div class="dialog-backdrop" data-dialog-close></div>
    <div class="dialog-panel" data-dialog-panel tabindex="-1">
      <h2 id="delete-title">确认删除账号</h2>
      <p class="text-secondary">账号权限和所有通知会立即停止，数据随后清理。已发出的邮件、日历应用里的副本和未到期的备份无法立即删除。</p>
      <p id="delete-restricted-note" class="callout callout--info" hidden>当前是恢复登录后的受限会话：无需再次验证，可以直接确认删除。</p>
      <div id="delete-proofs">
        <p class="text-secondary">为了安全，请先完成一次验证（二选一）：</p>
        <div class="proof-card">
          <h3>用当前邮箱验证码</h3>
          <div id="delete-otp">
            <div id="delete-current-turnstile"></div><p id="delete-current-turnstile-status" class="field-hint" role="status"></p>
            <button id="delete-current-send" class="button button--secondary" type="button">发送删除用途验证码</button>
            <form id="delete-current-form" autocomplete="off" class="inline-form">
              <div class="field"><label for="delete-current-code">删除用途验证码</label><input id="delete-current-code" class="otp-input" type="password" inputmode="numeric" maxlength={OTP_DIGITS} autocomplete="off" required /></div>
              <button id="delete-current-verify" class="button" type="submit" disabled>验证</button>
            </form>
            <p id="delete-current-status" class="proof-status" role="status">尚未验证。</p>
            <p class="field-hint">{otpNote}</p>
          </div>
        </div>
        <details class="disclosure disclosure--inline">
          <summary>或者用恢复码验证</summary>
          <form id="delete-proof-form" autocomplete="off" class="recovery-proof">
            <p class="field-hint">这一步只验证删除用途，不会删除账号，也不会消耗恢复码。</p>
            <div class="field"><label for="delete-recovery-id">恢复码 ID</label><input id="delete-recovery-id" type="password" autocomplete="off" required /></div>
            <div class="field"><label for="delete-recovery-secret">恢复码秘密</label><input id="delete-recovery-secret" type="password" autocomplete="off" required /></div>
            <button class="button button--secondary" id="delete-prove" type="submit" disabled>验证本次删除用途</button>
          </form>
        </details>
      </div>
      <p id="delete-proof-status" class="callout callout--info" role="status">尚未确认删除条件。</p>
      <div class="dialog-actions">
        <button class="button button--secondary" type="button" data-dialog-close>取消</button>
        <button class="button button--danger" id="delete-confirm" type="button" disabled>确认删除账号</button>
      </div>
    </div>
  </div>
  <script>
    import "../features/auth/sessions/account";
  </script>
</Layout>
