---
import "../styles/base.css";
import {
  defaultBrowseFilters,
  EVENT_NAMES,
  EVENT_TYPES,
  GAME_NAMES,
  NODE_NAMES,
  NODE_TYPES,
  SUPPORTED_SCOPE_GAMES,
} from "@hoyo/contracts";
import GameIcon from "../components/GameIcon.astro";
import Icon from "../components/Icon.astro";
import { HOME_RANGES } from "../features/schedule/ranges";
import { GAME_SHORT_NAMES } from "../lib/game-icons";
import Layout from "./_Layout.astro";
import "../features/schedule/schedule.css";

const filters = defaultBrowseFilters();
---
<Layout title="活动日程" activeNav="schedule">
  <div class="schedule-page">
    <h1 class="sr-only">活动日程</h1>

    <form id="browse-filters" class="filter-bar" aria-label="筛选日程">
      <div class="filter-scroller">
        <fieldset class="filter-group">
          <legend class="sr-only">游戏</legend>
          <div class="game-options">
            {SUPPORTED_SCOPE_GAMES.map((game) => (
              <label class="chip game-option" data-game={game}>
                <input type="checkbox" name="games" value={game} checked />
                <GameIcon game={game} class="game-icon game-icon--md" />
                <span class="game-name">{GAME_NAMES[game]}</span>
                <span class="game-name-short" aria-hidden="true">{GAME_SHORT_NAMES[game]}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <span class="filter-divider" aria-hidden="true"></span>
        <label class="chip deadline-filter">
          <input type="checkbox" name="ending" value="1" />
          <Icon name="hourglass" />
          <span>只看截止</span>
        </label>
        <button id="reset-filters" type="button" class="link-button reset-filters" hidden>清除筛选</button>
      </div>
      <div class="filter-pinned">
        <button
          id="more-filters-toggle"
          type="button"
          class="chip more-toggle"
          popovertarget="more-filters"
          aria-haspopup="dialog"
          aria-controls="more-filters"
          aria-expanded="false"
        >
          <Icon name="sliders" />
          <span class="more-label">筛选</span>
          <span id="more-range" class="more-range">{HOME_RANGES.find((range) => range.id === filters.range)?.label}</span>
          <span id="more-summary" class="more-summary" hidden></span>
        </button>
      </div>
      <div id="more-filters" class="more-popover" popover role="dialog" aria-labelledby="more-filters-title">
        <div class="more-head">
          <h2 id="more-filters-title">筛选</h2>
          <button type="button" class="more-close" popovertarget="more-filters" popovertargetaction="hide" aria-label="关闭筛选">
            <Icon name="x" />
          </button>
        </div>
        <fieldset class="more-group">
          <legend class="filter-label">时间范围</legend>
          <div class="segmented range-options">
            <span class="segmented-thumb" aria-hidden="true"></span>
            {HOME_RANGES.map((range) => (
              <label class="range-option">
                <input type="radio" name="range" value={range.id} checked={range.id === filters.range} />
                <span>{range.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="more-group">
          <legend class="filter-label">活动类型</legend>
          <div class="chip-group">
            {EVENT_TYPES.map((type) => (
              <label class="chip">
                <input type="checkbox" name="events" value={type} />
                <Icon name="check" class="chip-check" />
                <span>{EVENT_NAMES[type]}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="more-group">
          <legend class="filter-label">节点类型</legend>
          <div class="chip-group">
            {NODE_TYPES.map((type) => (
              <label class="chip">
                <input type="checkbox" name="nodes" value={type} />
                <Icon name="check" class="chip-check" />
                <span>{NODE_NAMES[type]}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="more-foot">
          <button id="more-clear" type="button" class="link-button">清除这些条件</button>
          <button type="button" class="button button--sm" popovertarget="more-filters" popovertargetaction="hide">完成</button>
        </div>
      </div>
      <p id="browse-summary" class="sr-only" aria-live="polite"></p>
    </form>

    <!-- ADR-0030：有效兑换码；有可显示的兑换码时才出现。 -->
    <section id="redeem-codes" class="redeem-bar" aria-labelledby="redeem-title" hidden></section>

    <section id="ending-soon" class="ending-soon" aria-labelledby="ending-soon-title" aria-busy="true">
      <div class="ending-head">
        <h2 id="ending-soon-title" class="ending-heading">
          <span class="ending-pulse" aria-hidden="true"></span>即将截止
        </h2>
      </div>
      <div class="ending-cards" role="status">
        <span class="sr-only">正在加载即将截止的活动…</span>
        <div class="ending-card skeleton-card"><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-block"></div></div>
        <div class="ending-card skeleton-card"><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-block"></div></div>
        <div class="ending-card skeleton-card"><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-block"></div></div>
        <div class="ending-card skeleton-card"><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-block"></div></div>
      </div>
    </section>

    <div class="schedule-layout">
      <div id="schedule-results" class="schedule-results" aria-busy="true">
        <section class="timeline card" aria-label="正在加载日程">
          <div class="timeline-skeleton" role="status">
            <span class="sr-only">正在加载公开日程…</span>
            <div class="skeleton skeleton-line"></div>
            <div class="skeleton skeleton-row"></div>
            <div class="skeleton skeleton-row"></div>
            <div class="skeleton skeleton-row"></div>
          </div>
        </section>
      </div>
      <aside class="schedule-aside" aria-label="日程概览">
        <div id="schedule-aside-dynamic" class="aside-stack"></div>
        <section class="card aside-card subscribe-card">
          <div class="card-body">
            <div class="subscribe-icon" aria-hidden="true"><Icon name="bell" /></div>
            <h2 class="aside-title">不想错过截止时间？</h2>
            <p>选好关注的游戏，生成私人日历链接。添加到手机或电脑日历后会自动更新，还能提前提醒你。</p>
            <a class="button button--block" href="/subscription">设置订阅<Icon name="arrow-right" /></a>
          </div>
        </section>
      </aside>
    </div>
    <p id="browse-announcement" class="sr-only" role="status"></p>
    <noscript><p class="callout callout--warning">启用 JavaScript 后可读取和筛选公开日程。</p></noscript>
  </div>
  <script>import "../features/schedule/home";</script>
</Layout>
