---
import {
  BROWSE_RANGES,
  BROWSE_TIMEZONE,
  defaultBrowseFilters,
  EVENT_NAMES,
  EVENT_TYPES,
  GAME_NAMES,
  NODE_NAMES,
  NODE_TYPES,
  SUPPORTED_SCOPE_GAMES,
} from "@hoyo/contracts";
import "../features/schedule/schedule.css";
import Layout from "./_Layout.astro";

const filters = defaultBrowseFilters();
---
<Layout title="日程" activeNav="schedule">
  <div class="schedule-home">
    <div class="schedule-intro">
      <div><p class="page-kicker">每一段旅程，都有迹可循</p><h1>日程<span class="title-dot" aria-hidden="true">.</span></h1></div>
      <div class="intro-aside"><p>CN · 简体中文</p><p>{BROWSE_TIMEZONE}</p></div>
    </div>
    <form id="browse-filters" class="browse-filters" aria-label="浏览筛选">
      <fieldset class="game-filters"><legend class="sr-only">游戏选择</legend><div class="game-options">
        {SUPPORTED_SCOPE_GAMES.map((game) => <label class="game-option"><input type="checkbox" name="games" value={game} checked /><span>{GAME_NAMES[game]}</span></label>)}
      </div></fieldset>
      <div class="filter-toolbar"><fieldset class="range-filters"><legend class="sr-only">时间范围</legend><div class="range-options">
        {BROWSE_RANGES.map((range) => <label class="range-option"><input type="radio" name="range" value={range.id} checked={range.id === filters.range} /><span>{range.label}</span></label>)}
      </div></fieldset></div><div class="filter-tools"><label class="deadline-filter"><input type="checkbox" name="ending" value="1" />临近截止</label>
      <details class="more-filters" id="more-filters"><summary>更多筛选<span id="more-summary">事件类型、节点类型</span></summary><div class="more-content">
        <fieldset><legend>事件类型</legend><div class="checkbox-options">{EVENT_TYPES.map((type) => <label><input type="checkbox" name="events" value={type} />{EVENT_NAMES[type]}</label>)}</div></fieldset>
        <fieldset><legend>节点类型</legend><div class="checkbox-options">{NODE_TYPES.map((type) => <label><input type="checkbox" name="nodes" value={type} />{NODE_NAMES[type]}</label>)}</div></fieldset>
      </div></details></div>
      <div class="filter-summary"><p id="browse-summary">全部游戏 · 近3天</p><button id="reset-filters" type="button">清除筛选</button></div>
    </form>
    <div id="schedule-results" aria-busy="true"><p role="status">正在加载公开日程…</p></div>
    <div class="subscription-hint"><div><strong>把日程，放进你的日历。</strong><p>浏览筛选只影响当前页面，订阅内容由你另行设置。</p></div><a href="/subscription">设置我的订阅 →</a></div>
    <p id="browse-announcement" class="sr-only" role="status"></p>
    <noscript><p class="data-warning">启用 JavaScript 后可读取和筛选公开日程。</p></noscript>
  </div>
  <script>import "../features/schedule/home";</script>
</Layout>
