---
import "../styles/base.css";
import { OTP_ATTEMPTS, OTP_COOLDOWN, OTP_DIGITS, OTP_TTL } from "@hoyo/contracts";
import FormField from "../components/FormField.astro";
import Icon from "../components/Icon.astro";
import Layout from "./_Layout.astro";
import "../features/auth/auth.css";

const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<Layout title="登录" noindex>
  <div class="auth-page">
    <div id="login" class="card auth-card" data-sitekey={sitekey}>
      <div class="auth-head">
        <span class="auth-icon" aria-hidden="true"><Icon name="mail" /></span>
        <h1>登录或注册</h1>
        <p class="text-secondary">输入邮箱接收 {OTP_DIGITS} 位验证码，不需要密码。新邮箱会自动创建账号。</p>
      </div>
      <ol class="auth-progress" aria-label="登录步骤">
        <li data-auth-step="email" aria-current="step">邮箱</li>
        <li data-auth-step="code">验证码</li>
        <li data-auth-step="pending">确认设备</li>
      </ol>
      <p id="login-return-notice" class="callout callout--info" role="status" hidden></p>
      <p id="auth-service" class="auth-service" role="status">正在读取服务状态…</p>

      <form id="email-form" novalidate>
        <FormField id="login-email" label="邮箱地址" type="email" placeholder="you@example.com"
          hint="首版支持 ASCII 邮箱。点号、加号等都会原样保留。" autocomplete="email" />
        <div id="turnstile" class="turnstile"></div>
        <p id="turnstile-status" class="field-hint"></p>
        <button class="button button--block" type="submit" id="login-request-otp">发送验证码</button>
      </form>

      <section id="code-section" hidden aria-labelledby="code-title">
        <h2 id="code-title">输入验证码</h2>
        <p class="text-secondary">如果这个邮箱可以登录或注册，验证码已经发出。请查看收件箱，邮件可能稍晚到达。</p>
        <p id="challenge-time" class="field-hint"></p>
        <form id="code-form" novalidate>
          <div class="field">
            <label for="login-code">验证码</label>
            <input id="login-code" class="otp-input" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength={OTP_DIGITS} aria-describedby="code-hint" />
            <p id="code-hint" class="field-hint">可以直接粘贴整段验证码。</p>
          </div>
          <div class="auth-actions">
            <button class="button button--block" id="verify" type="submit">确认验证码</button>
            <button class="button button--ghost button--block" id="resend" type="button">重新发送验证码</button>
          </div>
        </form>
        <details class="disclosure disclosure--inline auth-tips">
          <summary>收不到验证码？</summary>
          <ul>
            <li>验证码 {OTP_DIGITS} 位，{OTP_TTL / 60} 分钟内有效；重新发送至少间隔 {OTP_COOLDOWN} 秒。</li>
            <li>重新发送不会延长有效期，每次最多允许输错 {OTP_ATTEMPTS} 次。</li>
            <li>请检查垃圾邮件。发件域名是 auth.hoyo.airo.cc，部分邮箱会显示「由 cf-bounce.auth.hoyo.airo.cc 代发」，这是正常的。</li>
          </ul>
        </details>
      </section>

      <section id="pending-section" hidden aria-labelledby="pending-title">
        <h2 id="pending-title">最后一步：确认在这台设备登录</h2>
        <p class="text-secondary">确认后这台设备会占用一个登录名额。</p>
        <p id="completion-time" class="field-hint"></p>
        <p id="session-notice" class="field-hint"></p>
        <FormField id="device-label" label="给这台设备起个名字（可选）" hint="方便以后在账号设置里辨认，例如「我的手机」。不要填写邮箱等私人信息。" />
        <fieldset id="device-selection" class="device-selection" hidden>
          <legend>登录设备已满，请选择要退出的旧设备</legend>
          <p class="field-hint">不会自动退出其他设备。退出登录不会关闭那台设备的浏览器通知。</p>
          <p id="session-lag" class="field-hint"></p>
          <div id="session-list" class="device-list"></div>
        </fieldset>
        <button class="button button--block" id="activate" type="button">确认登录</button>
      </section>

      <p id="auth-result" class="callout callout--info result-message" role="status" tabindex="-1"></p>
      <div class="auth-actions auth-actions--row">
        <button class="button button--secondary" id="retry-auth" type="button" hidden>核对结果</button>
        <button class="button button--ghost" id="cancel-wait" type="button" hidden>停止等待</button>
        <button class="button button--ghost" id="restart-auth" type="button" hidden>重新开始 / 更换邮箱</button>
      </div>
      <p id="login-done" hidden><a class="button button--block" id="continue-login" href="/subscription">继续<Icon name="arrow-right" /></a></p>
      <p id="auth-help" class="auth-help" hidden><a href="/recover">用恢复码找回账号</a><span aria-hidden="true">·</span><a href="/status">查看服务状态</a></p>
      <noscript><p class="callout callout--warning">验证码登录需要启用 JavaScript；公开日程仍可浏览。</p></noscript>
    </div>
    <p class="auth-foot">登录只恢复你的账号身份，不会自动修改订阅或开启任何通知。</p>
  </div>
  <script>import "../features/auth/login";</script>
</Layout>
