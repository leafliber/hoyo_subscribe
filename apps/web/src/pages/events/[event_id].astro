---
import { renderEventDetail } from "../../features/schedule/detail";
import type { DemoEvent } from "../../features/schedule/fixtures";
import { demoEvent, demoEventIds } from "../../features/schedule/fixtures";
import "../../features/schedule/detail.css";
import Layout from "../_Layout.astro";

export function getStaticPaths() {
  const now = Date.now();
  return demoEventIds(now).map((id) => {
    const event = demoEvent(now, id);
    if (!event) throw new Error(`未知的 synthetic 事件：${id}`);
    return { params: { event_id: id }, props: { event, now } };
  });
}

const { event, now } = Astro.props as { event: DemoEvent; now: number };
---
<Layout title={event.title} activeNav="schedule">
  <div set:html={renderEventDetail(event, now)} />
</Layout>
