---
import "../styles/base.css";
import {
  CALENDAR_ALARMS_DEFAULT,
  CHANGE_DEFAULTS,
  DEFAULT_CALENDAR_EVENT_TYPES,
  DEFAULT_CALENDAR_NODE_TYPES,
  DEFAULT_RULE_IDS,
  DEFAULT_SCOPE_GAMES,
  EVENT_TYPES,
  NODE_TYPES,
  REMINDER_RULES,
  SUBSCRIPTION_CHANGE_COPY,
  SUBSCRIPTION_GAME_LABELS,
  SUBSCRIPTION_NODE_TYPE_LABELS,
  SUBSCRIPTION_RULE_COPY,
  SUPPORTED_SCOPE_GAMES,
} from "@hoyo/contracts";
import GameIcon from "../components/GameIcon.astro";
import Icon from "../components/Icon.astro";
import Layout from "./_Layout.astro";
import "../features/subscription/subscription.css";

const recommended = new Set<string>(DEFAULT_RULE_IDS);
const eventMeta = {
  livestream: { label: "前瞻直播", desc: "版本前瞻特别节目", icon: "tv" },
  maintenance: { label: "版本维护", desc: "停服维护与更新", icon: "wrench" },
  limited_event: { label: "限时活动", desc: "活动开放、阶段与奖励截止", icon: "flag" },
  gacha: { label: "卡池", desc: "限定卡池开启与结束", icon: "sparkles" },
  // ADR-0030：米游社官方直播页的兑换码。
  redeem_code: { label: "兑换码", desc: "前瞻直播兑换码发放与过期", icon: "gift" },
} as const;
const ruleGroups = EVENT_TYPES.map((type) => ({
  type,
  label: eventMeta[type].label,
  rules: REMINDER_RULES.filter((rule) => rule.event_type === type).map((rule) => ({
    id: rule.rule_id,
    label:
      SUBSCRIPTION_RULE_COPY.find((copy) => copy.rule_id === rule.rule_id)?.label ?? rule.rule_id,
  })),
})).filter((group) => group.rules.length > 0);
const changeMeta: Record<string, string> = {
  cancelled_or_retracted: "活动被官方取消，或本站撤回错误收录",
  important_change: "开始/结束时间改动等重要更正",
  late_discovery: "较晚才收录、来不及按原计划提醒的活动",
  new_event: "有新的活动或卡池公布",
};
const changeOrder = ["cancelled_or_retracted", "important_change", "late_discovery", "new_event"];
// ADR-0029：第 2 步三选一，浏览器通知与日历订阅标推荐；入口只跳到「接收方式」里对应的卡片。
const receiveOptions = [
  {
    id: "push",
    href: "#push-channel",
    icon: "bell",
    title: "浏览器通知",
    desc: "在这台设备的浏览器里弹出通知，不用装应用。",
    recommended: true,
  },
  {
    id: "calendar",
    href: "#calendar-channel",
    icon: "calendar",
    title: "日历订阅",
    desc: "添加到手机或电脑的日历应用，新活动和改期自动同步。",
    recommended: true,
  },
  {
    id: "mail",
    href: "#mail-channel",
    icon: "mail",
    title: "邮件通知",
    desc: "活动取消、改期等重要变化发到你的邮箱。",
    recommended: false,
  },
] as const;
const changes = [...SUBSCRIPTION_CHANGE_COPY].sort(
  (a, b) => changeOrder.indexOf(a.key) - changeOrder.indexOf(b.key),
);
---

<Layout title="我的订阅" activeNav="subscription">
  <div class="subscription-page">
    <header class="page-header">
      <div>
        <h1>我的订阅</h1>
        <p class="lead">选好关注的游戏和提醒，再选择用浏览器通知、日历或邮件接收。</p>
      </div>
      <div class="sub-state" aria-live="polite">
        <span id="cloud-state" class="status-pill">正在读取…</span>
        <span id="draft-state" class="sub-state-detail"></span>
      </div>
    </header>

    <!-- 两步引导（ADR-0026、ADR-0029）：保存订阅内容 → 选择接收方式（三选一）。恢复码可选，在账号设置里管理；全部完成后隐藏。 -->
    <section id="setup-progress" class="setup-card" aria-labelledby="setup-title">
      <div class="setup-main">
        <div class="setup-head">
          <h2 id="setup-title">开始使用</h2>
          <p id="cloud-flow-status" class="setup-status" role="status">先选择订阅内容，登录后保存。</p>
        </div>
        <ol class="setup-steps" id="setup-steps">
          <li data-step="save" data-state="current">
            <span class="step-index" aria-hidden="true">1</span>
            <div><p class="step-title">选择内容并保存</p><p class="step-desc">登录后保存到云端，任何设备都能修改。</p></div>
          </li>
          <li data-step="receive" data-state="todo">
            <span class="step-index" aria-hidden="true">2</span>
            <div><p class="step-title">选择接收方式</p><p class="step-desc">浏览器通知、日历订阅、邮件通知，任选一种。</p></div>
          </li>
        </ol>
        <div id="receive-choice" class="receive-choice" hidden>
          <ul class="receive-options" aria-label="选择一种接收方式">
            {receiveOptions.map((option) => (
              <li data-receive-item={option.id} hidden={option.id === "push"}>
                <a class="receive-option" data-receive={option.id} data-href={option.href} href={option.href} data-recommended={option.recommended ? "" : undefined}>
                  <span class="receive-option-icon" aria-hidden="true"><Icon name={option.icon} /></span>
                  <span class="receive-option-text">
                    <span class="receive-option-title">{option.title}{option.recommended && <span class="badge badge--accent">推荐</span>}</span>
                    <span class="receive-option-desc">{option.desc}</span>
                    <span class="receive-option-note" data-receive-note hidden></span>
                  </span>
                  <Icon name="chevron-right" class="receive-option-go" />
                </a>
              </li>
            ))}
          </ul>
          <p class="receive-choice-foot">任选一种就能用，之后可以在「接收方式」里增加或关闭；同时开启几种可能收到重复提醒。</p>
        </div>
      </div>
      <div class="setup-actions">
        <a id="subscription-login" class="button" href="/login?returnTo=%2Fsubscription"><Icon name="user" />登录后保存</a>
        <a id="save-recovery-link" class="button" href="/recover#save" hidden><Icon name="key" />保存新恢复码</a>
      </div>
    </section>

    <!-- 功能分区：「订阅内容」决定收什么，「接收方式」决定怎么收；只切换显示，不发请求。 -->
    <div class="sub-tablist" role="tablist" aria-label="我的订阅分区">
      <button type="button" class="sub-tab" role="tab" id="tab-content" data-tab="content" aria-controls="panel-content" aria-selected="true">
        <span class="sub-tab-icon" aria-hidden="true"><Icon name="sliders" /></span>
        <span class="sub-tab-text"><span class="sub-tab-title">订阅内容</span><span class="sub-tab-desc">关注的游戏、日历显示和提醒规则</span></span>
        <span id="tab-content-badge" class="badge badge--warning sub-tab-badge" hidden>未保存</span>
      </button>
      <button type="button" class="sub-tab" role="tab" id="tab-channels" data-tab="channels" aria-controls="panel-channels" aria-selected="false" tabindex="-1">
        <span class="sub-tab-icon" aria-hidden="true"><Icon name="bell" /></span>
        <span class="sub-tab-text"><span class="sub-tab-title">接收方式</span><span class="sub-tab-desc">浏览器通知、日历订阅和邮件</span></span>
      </button>
    </div>

    <div id="panel-content" class="sub-panel" role="tabpanel" aria-labelledby="tab-content">
      <div class="sub-layout">
        <form id="subscription-form" class="sub-form" novalidate>
          <section class="card sub-section" aria-labelledby="games-heading">
            <div class="sub-section-head">
              <h2 id="games-heading">关注的游戏</h2>
              <p>日历和通知只包含这些游戏。</p>
            </div>
            <fieldset aria-describedby="game-error">
              <legend class="visually-hidden">关注的游戏</legend>
              <div class="game-picker">
                {SUPPORTED_SCOPE_GAMES.map((game) => (
                  <label class="game-card" data-game={game}>
                    <input type="checkbox" name="games" value={game} checked={DEFAULT_SCOPE_GAMES.includes(game)} />
                    <GameIcon game={game} class="game-icon game-icon--lg" />
                    <span class="game-card-name">{SUBSCRIPTION_GAME_LABELS[game]}</span>
                    <Icon name="check" class="game-card-check" />
                  </label>
                ))}
              </div>
            </fieldset>
            <p id="game-error" class="field-error" role="alert" tabindex="-1" hidden>至少选择一个关注的游戏。</p>
          </section>

          <section class="card sub-section" aria-labelledby="calendar-heading">
            <div class="sub-section-head">
              <h2 id="calendar-heading">日历里显示什么</h2>
              <p>选择要放进日历的活动类型。</p>
            </div>
            <fieldset aria-describedby="event-type-error">
              <legend class="visually-hidden">显示的活动类型</legend>
              <div class="type-grid">
                {EVENT_TYPES.map((type) => (
                  <label class="type-card">
                    <input type="checkbox" name="event_types" value={type} checked={DEFAULT_CALENDAR_EVENT_TYPES.includes(type)} />
                    <span class="type-icon" aria-hidden="true"><Icon name={eventMeta[type].icon} /></span>
                    <span class="type-text"><span class="type-name">{eventMeta[type].label}</span><span class="type-desc">{eventMeta[type].desc}</span></span>
                    <Icon name="check" class="type-check" />
                  </label>
                ))}
              </div>
            </fieldset>
            <p id="event-type-error" class="field-error" role="alert" tabindex="-1" hidden>至少选择一种日历活动类型。</p>
            <details id="calendar-settings" class="disclosure sub-advanced">
              <summary>显示哪些时间节点 <span id="calendar-summary" class="summary-hint"></span></summary>
              <fieldset class="sub-advanced-body">
                <legend class="visually-hidden">基础显示的节点</legend>
                <p class="field-hint">一个活动通常有开始、结束等多个节点。取消勾选的节点不会单独出现在日历里，但开启了相应提醒时仍会保留。</p>
                <div class="chip-group">
                  {NODE_TYPES.map((type) => (
                    <label class="chip">
                      <input type="checkbox" name="node_types" value={type} checked={DEFAULT_CALENDAR_NODE_TYPES.includes(type)} />
                      <Icon name="check" class="chip-check" />
                      <span>{SUBSCRIPTION_NODE_TYPE_LABELS[type]}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </details>
          </section>

          <section class="card sub-section" aria-labelledby="rules-heading">
            <div class="sub-section-head">
              <h2 id="rules-heading">提前提醒</h2>
              <p>在开始或截止前提醒你。可以一条都不选。</p>
            </div>
            <label class="switch alarm-switch">
              <input type="checkbox" name="alarms_enabled" checked={CALENDAR_ALARMS_DEFAULT} aria-describedby="alarm-status" />
              <span class="switch-text"><span class="check-title">在日历中提醒我</span><span id="alarm-status" class="check-desc"></span></span>
            </label>
            <div id="recommended-rules" class="rule-groups">
              {ruleGroups.map((group) => (
                <fieldset class="rule-group">
                  <legend class="rule-group-title">{group.label}</legend>
                  {group.rules.map((rule) => (
                    <label class="check">
                      <input type="checkbox" name="rule_ids" value={rule.id} checked={recommended.has(rule.id)} />
                      <span class="check-text"><span class="check-title rule-title">{rule.label}{recommended.has(rule.id) && <span class="badge badge--accent">推荐</span>}</span></span>
                    </label>
                  ))}
                </fieldset>
              ))}
            </div>
            <p id="rule-empty-note" class="callout callout--info rule-note" role="status" hidden>不会收到提前提醒；活动取消或改期的通知仍会按下方设置发送。</p>
          </section>

          <section class="card sub-section" aria-labelledby="change-heading">
            <div class="sub-section-head">
              <h2 id="change-heading">变化通知</h2>
              <p>活动有变化时通知你（开启邮件通知后生效）。</p>
            </div>
            <fieldset>
              <legend class="visually-hidden">变化通知类型</legend>
              <div class="check-list">
                {changes.map((item) => (
                  <label class="check">
                    <input type="checkbox" name={item.key} checked={CHANGE_DEFAULTS[item.key]} />
                    <span class="check-text"><span class="check-title">{item.label}</span><span class="check-desc">{changeMeta[item.key]}</span></span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p id="change-scope" class="field-hint change-scope"></p>
          </section>

          <div id="save-bar" class="save-bar" data-phase="guest">
            <div class="save-bar-inner">
              <p id="save-result" class="save-message" role="status">当前选择尚未保存。</p>
              <div class="save-actions">
                <button id="recheck-save" class="button button--ghost" type="button" hidden>重新读取</button>
                <button id="discard-changes" class="button button--secondary" type="button">放弃修改</button>
                <button id="save-subscription" class="button" type="submit">保存订阅</button>
              </div>
            </div>
          </div>

          <section id="save-comparison" class="card comparison" aria-labelledby="save-comparison-heading" hidden>
            <div class="card-body">
              <h2 id="save-comparison-heading"><Icon name="alert-triangle" />请选择要保留的设置</h2>
              <p id="save-comparison-message">云端设置和本机修改不一致，可能是在另一台设备上改过。不会自动覆盖，请选择保留哪一份。</p>
              <div id="save-differences" class="diff-table"></div>
              <div class="button-row">
                <button id="keep-draft" class="button" type="button">保留我的修改</button>
                <button id="adopt-cloud" class="button button--secondary" type="button">使用云端设置</button>
              </div>
            </div>
          </section>
          <div id="local-preferences-slot"></div>
        </form>

        <aside class="sub-preview" aria-labelledby="preview-heading">
          <section id="actual-preview" class="card preview-card">
            <div class="card-header">
              <h2 id="preview-heading"><Icon name="calendar" />日历预览</h2>
            </div>
            <div id="calendar-preview-content" class="preview-body">
              <p class="text-aux">正在准备预览…</p>
            </div>
          </section>
        </aside>
      </div>
    </div>

    <div id="panel-channels" class="sub-panel receive-section" role="tabpanel" aria-labelledby="tab-channels" hidden>
      <h2 id="receive-heading" class="visually-hidden">接收方式</h2>
      <p id="channel-saved-summary" class="receive-summary">日历和邮件会使用你已保存的设置。</p>
      <p id="calendar-first-save" class="callout callout--info" hidden>保存一次订阅后，就可以开启浏览器通知、日历订阅或邮件通知。</p>
      <div class="receive-grid">
        <section id="calendar-channel" class="card channel-card" aria-labelledby="calendar-channel-heading">
          <div class="card-body">
            <h3 id="calendar-channel-heading" class="channel-title"><Icon name="calendar" />日历订阅</h3>
            <p class="text-secondary">正在确认账号和已保存的订阅…</p>
          </div>
        </section>
        <section id="mail-channel" class="card channel-card" aria-labelledby="mail-channel-heading">
          <div class="card-body">
            <h3 id="mail-channel-heading" class="channel-title"><Icon name="mail" />邮件通知</h3>
            <p class="text-secondary">正在确认账号和已保存的订阅…</p>
          </div>
        </section>
        <section id="push-channel" class="card channel-card push-panel" aria-labelledby="push-channel-heading" hidden></section>
      </div>
    </div>
  </div>
  <script>
    import "../features/subscription/page";
  </script>
</Layout>
