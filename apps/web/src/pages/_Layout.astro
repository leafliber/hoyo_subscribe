---
import "../styles/base.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  activeNav?: "schedule" | "subscription";
  description?: string;
  /** 私人页面不需要被搜索引擎收录。 */
  noindex?: boolean;
}

const {
  title,
  activeNav,
  description = "原神、崩坏：星穹铁道、绝区零的官方活动日程，一次设置，自动同步到你的日历。",
  noindex = false,
} = Astro.props;
const siteName = "HoYo日历";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · {siteName}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="app-header">
      <div class="app-header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><Icon name="calendar" /></span>
          <span class="brand-text">{siteName}</span>
        </a>
        <nav class="primary-nav" aria-label="主导航">
          <ul>
            <li><a href="/" aria-current={activeNav === "schedule" ? "page" : undefined}>日程</a></li>
            <li>
              <a href="/subscription" aria-current={activeNav === "subscription" ? "page" : undefined}>我的订阅</a>
            </li>
          </ul>
        </nav>
        <a class="account-entry" href="/login" data-account-entry>
          <Icon name="user" />
          <span data-account-label>登录</span>
        </a>
      </div>
    </header>
    <p class="app-status" id="global-status" role="status" data-kind="info"></p>
    <main class="app-main" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="app-footer">
      <div class="app-footer-inner">
        <nav class="footer-nav" aria-label="页脚">
          <ul>
            <li><a href="/help">帮助</a></li>
            <li><a href="/status">服务状态</a></li>
          </ul>
        </nav>
        <p class="footer-note">本站非米哈游官方网站。活动信息整理自官方公告，请以官方最新公告为准；时间均为北京时间。</p>
      </div>
    </footer>
    <script>
      import "../components/dialog";
      import "../components/status";
      import "../components/header-auth";
    </script>
  </body>
</html>
