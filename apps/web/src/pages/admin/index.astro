---
import "../../styles/base.css";
import "../../features/admin/admin.css";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>管理审核</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <main class="app-main" id="main" tabindex="-1">
      <header class="admin-heading"><h1>管理审核</h1><span>人工核对官方材料</span></header>
      <p class="admin-help">建议用单独的浏览器配置文件登录管理端。管理员与用户共用 CSRF Cookie；登录管理端会覆盖用户页的 CSRF Cookie，用户页写操作将被拒绝，直到重新取得 CSRF。</p>
      <p id="notice" role="status" aria-live="polite"></p>
      <button id="reload" class="button button--secondary" type="button">重新读取队列</button>
      <form id="login" class="form-narrow" hidden autocomplete="off">
        <div class="field">
          <label for="secret">引导秘密</label>
          <input id="secret" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" required />
        </div>
        <button class="button" type="submit">登录管理端</button>
      </form>
      <section id="workspace" hidden aria-label="审核工作区">
        <div class="admin-actions">
          <button id="new" class="button button--secondary" type="button">新建候选</button>
          <button id="logout" class="button button--secondary" type="button">退出管理端</button>
        </div>
        <section aria-labelledby="queue-title">
          <h2 id="queue-title">待审队列</h2>
          <p id="queue-state" role="status"></p>
          <ul id="queue"></ul>
        </section>
        <section id="review" hidden aria-labelledby="detail-title">
          <h2 id="detail-title" tabindex="-1">候选详情</h2>
          <p id="candidate-meta"></p>
          <p id="candidate-error" class="field-error" role="alert"></p>
          <div class="admin-columns">
            <section aria-labelledby="article-title">
              <h2 id="article-title">保存的公告正文块</h2>
              <p id="article-meta"></p>
              <div id="blocks"></div>
              <h2>逐条证据</h2>
              <ol id="evidence"></ol>
            </section>
            <form id="editor">
              <fieldset id="editor-fields">
                <legend>候选内容与人工裁定</legend>
                <div class="field">
                  <label for="article_version_id">文章版本 article_version_id（新建时指定）</label>
                  <input id="article_version_id" required aria-describedby="article_version_id-error" />
                  <p id="article_version_id-error" class="field-error"></p>
                </div>
                <div class="field">
                  <label for="proposal_json">候选 JSON · proposal_json</label>
                  <textarea id="proposal_json" rows="16" required spellcheck="false" aria-describedby="proposal_json-error proposal-help"></textarea>
                  <p id="proposal-help" class="field-hint">候选规则由服务端校验。修改 JSON 后，先选择“修正”并提交保存，再进行其他裁定。</p>
                  <p id="proposal_json-error" class="field-error"></p>
                  <details><summary>服务端已保存的候选（核对冲突）</summary><pre id="saved-proposal"></pre></details>
                </div>
                <div class="field">
                  <label for="action">审核操作</label>
                  <select id="action">
                    <option value="revise">修正（保存候选 JSON）</option>
                    <option value="reject">驳回</option>
                    <option value="approve">批准</option>
                    <option value="correct">纠正（发布受保护字段更正）</option>
                    <option value="associate">关联（跨公告关联）</option>
                    <option value="retract">撤回</option>
                  </select>
                </div>
                <div class="field" id="target-field" hidden>
                  <label for="target_event_id">目标事件 target_event_id</label>
                  <input id="target_event_id" aria-describedby="target_event_id-error" />
                  <p id="target_event_id-error" class="field-error"></p>
                </div>
                <div class="field">
                  <label for="reason">操作理由</label>
                  <textarea id="reason" rows="3" required aria-describedby="reason-error"></textarea>
                  <p id="reason-error" class="field-error"></p>
                </div>
                <button id="submit" class="button" type="submit">提交操作</button>
              </fieldset>
            </form>
          </div>
          <section aria-label="操作结果">
            <p id="publication" role="status"></p>
            <button id="retry-publication" type="button" class="button" hidden>重试发布</button>
            <p id="retry-help" hidden>重试会重新读取候选，并使用最新版本重发同一操作与理由。</p>
          </section>
        </section>
      </section>
      <noscript>请启用 JavaScript 后使用管理审核页面。</noscript>
    </main>
    <script>
      import "../../features/admin/page";
    </script>
  </body>
</html>
